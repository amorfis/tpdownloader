# Copy to .env and fill in. Anything left out (or empty) is taken from environment variables,
# then from the macOS Keychain: .venv/bin/python -m keyring set tpdownloader <NAME>
TPDOWNLOADER_SITE_USERNAME=
TPDOWNLOADER_SITE_PASSWORD=
TPDOWNLOADER_GMAIL_ADDRESS=
# Gmail App Password (Google Account → Security → App passwords), not your normal password
TPDOWNLOADER_GMAIL_APP_PASSWORD=
# Where the file is emailed, e.g. your Send to Kindle address
TPDOWNLOADER_SEND_TO=
# Optional: ntfy topic for phone notifications (install the ntfy app and subscribe to it).
# Anyone who knows it can read the notifications, so make it hard to guess.
TPDOWNLOADER_NTFY_TOPIC=
